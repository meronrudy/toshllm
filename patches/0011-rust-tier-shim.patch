+# Optional ToshLLM Rust tier runtime. This is deliberately an imported static
+# library so the production engine build stays unchanged unless the caller
+# supplies both paths. The Rust side owns policy only; ggml/Metal remains the
+# executor.
+if (TOSH_TIER_LIB AND TOSH_TIER_INCLUDE_DIR)
+    add_library(tosh-tier-runtime STATIC IMPORTED GLOBAL)
+    set_target_properties(tosh-tier-runtime PROPERTIES IMPORTED_LOCATION "${TOSH_TIER_LIB}")
+    target_include_directories(${TARGET} PRIVATE "${TOSH_TIER_INCLUDE_DIR}")
+    target_compile_definitions(${TARGET} PRIVATE TOSH_TIER_LINKED=1)
+    target_link_libraries(${TARGET} PUBLIC tosh-tier-runtime)
+endif()
+
 if (LLAMA_LLGUIDANCE)
     include(ExternalProject)
     set(LLGUIDANCE_SRC ${CMAKE_BINARY_DIR}/llguidance/source)
