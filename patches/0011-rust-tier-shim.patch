     return true;
 }
 
+#ifdef TOSH_TIER_LINKED
+static ToshTierRuntime * g_tosh_tier_runtime = nullptr;
+
+static void common_tosh_tier_shutdown() {
+    if (g_tosh_tier_runtime != nullptr) {
+        tosh_tier_runtime_destroy(g_tosh_tier_runtime);
+        g_tosh_tier_runtime = nullptr;
+    }
+}
+
+static void common_tosh_tier_init() {
+    if (g_tosh_tier_runtime != nullptr) {
+        return;
+    }
+
+    const uint32_t rust_abi = tosh_tier_abi_version();
+    if (rust_abi != TOSH_TIER_ABI_VERSION) {
+        fprintf(stderr, "tosh-tier: ABI mismatch: engine=%u rust=%u; runtime disabled\n",
+                TOSH_TIER_ABI_VERSION, rust_abi);
+        return;
+    }
+
+    ToshTierConfigV1 config = {};
+    config.abi_version = TOSH_TIER_ABI_VERSION;
+    config.struct_size = static_cast<uint32_t>(sizeof(config));
+
+    const int32_t status = tosh_tier_runtime_create(&config, &g_tosh_tier_runtime);
+    if (status != TOSH_TIER_STATUS_OK || g_tosh_tier_runtime == nullptr) {
+        fprintf(stderr, "tosh-tier: runtime create failed: status=%d; continuing without tier runtime\n",
+                status);
+        g_tosh_tier_runtime = nullptr;
+        return;
+    }
+
+    std::atexit(common_tosh_tier_shutdown);
+
+    if (std::getenv("TOSH_TIER_LOG") != nullptr) {
+        fprintf(stderr, "tosh-tier: linked ABI %u version %s enabled=%s\n",
+                rust_abi,
+                tosh_tier_version_string(),
+                tosh_tier_runtime_is_enabled(g_tosh_tier_runtime) ? "yes" : "no");
+    }
+}
+#endif
+
 void common_init() {
 #if defined(_WIN32)
     SetConsoleOutputCP(CP_UTF8);
@@ -393,6 +441,10 @@ void common_init() {
     common_log_set_timestamps(common_log_main(), true);
 
     llama_log_set(common_log_default_callback, NULL);
+
+#ifdef TOSH_TIER_LINKED
+    common_tosh_tier_init();
+#endif
